# ── LLM Relay ────────────────────────────────────────────────────────
# All model calls (item generation + agent solving) route through llm-relay.
# No provider API keys are needed in this repo — the relay manages them.
RELAY_BASE_URL=https://llm-relay.ebarakos.workers.dev/v1
RELAY_PROVIDER=cerebras
RELAY_MODEL=llama3.1-8b

# Local relay (when running ../llm-relay with `wrangler dev`):
# RELAY_BASE_URL=http://localhost:8787/v1

# ── Optional BYO provider keys ───────────────────────────────────────
# Forwarded as X-User-Api-Key to bypass the relay's shared rate limit.
# Only set if you want to skip the shared quota. NEVER commit real keys.
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
