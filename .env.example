# ── LLM Relay ────────────────────────────────────────────────────────
# Agent solving and optional offline model-writing calls route through llm-relay.
# No provider API keys are required in this repo for free models — the relay
# manages a shared quota. Paid models need a BYO key (see below).
# Default for this app since 2026-08-27: the developer's own Codex sign-in,
# through the relay's localhost harness bridge. It needs the LOCAL relay and the
# bridge to be running, so the base URL below is the local one.
RELAY_BASE_URL=http://localhost:8787/v1
RELAY_PROVIDER=codex
RELAY_MODEL=sol
# Harness providers take reasoning effort as a request body field, not a header.
# It changes the answers enough that a run records the value it used, and two
# runs at different efforts are not comparable.
RELAY_EFFORT=high

# Hosted alternative, no local bridge needed — a mid-tier OpenRouter model.
# Strong reasoning gives noticeably more correct puzzle answers than small free
# models, and this is what the v10 and v11 probe artifacts were recorded on.
# RELAY_BASE_URL=https://llm-relay.ebarakos.workers.dev/v1
# RELAY_PROVIDER=openrouter
# RELAY_MODEL=deepseek/deepseek-chat-v3-0324

# Free, keyless alternative (lower puzzle quality, occasional mis-marked answers):
# RELAY_BASE_URL=https://llm-relay.ebarakos.workers.dev/v1
# RELAY_PROVIDER=groq
# RELAY_MODEL=llama-3.3-70b-versatile

# Development experiment only: allow an LLM to propose a strict bounded rule.
# Pure code still constructs and validates the puzzle; the normal quiz route
# never uses this path.
# ENABLE_LLM_RULE_PROPOSALS=1

# The visual-family pilot gallery is available automatically in development.
# Set this only when deliberately exposing that surface in a production-like run.
# ENABLE_SCENE_PROTOTYPES=1

# ── Withdrawing a question family ────────────────────────────────────
# Families are public as soon as they pass the code checks, so this list is the
# way to pull one back out after a human pilot shows it confuses people. Give
# the family ids separated by commas; the change takes effect on restart, with
# no deploy. The server refuses to start if the list leaves a band too thin to
# build the 30-question test.
# The server also refuses to start on an id that matches no registered family,
# so keep this list to families that actually exist.
# WITHDRAWN_FAMILY_IDS=fold-punch-v2,rule-switching-v2

# ── BYO provider keys ────────────────────────────────────────────────
# Required for PAID models (e.g. the openrouter default above). Forwarded as
# X-User-Api-Key, which also bypasses the relay's shared rate limit.
# Put real keys in .env.local only — NEVER commit them.
# OPENROUTER_API_KEY=
# CEREBRAS_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ── Quiz scoring ────────────────────────────────────────────────────
# Required in production. Use a stable random value of at least 32 characters.
# It encrypts and authenticates answer keys in the opaque quiz token sent to the browser.
# QUIZ_TOKEN_SECRET=
