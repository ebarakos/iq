{
  "name": "aiq",
  "version": "0.1.0",
  "private": true,
  "description": "Visual IQ-style tests for humans and agents (MVP prototype)",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bank:topup": "node --env-file=.env.local --import tsx scripts/bank-topup.ts",
    "bank:verify": "tsx scripts/bank-verify.ts",
    "agent:smoke": "node --env-file=.env.local --import tsx scripts/agent-smoke.ts",
    "agent:run": "node --env-file=.env.local --import tsx scripts/agent-run.ts",
    "render:item": "tsx scripts/render-item.ts",
    "report": "tsx scripts/report.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.0",
    "ai": "^6.0.0",
    "next": "^15.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^2.0.0"
  }
}
